{
  "name": "little-eagle-football",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Somerset Little Eagle Football - youth football and cheer, Somerset PA. Astro 5 + Tailwind 4.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "qa": "node scripts/qa-redesign.mjs",
    "qa:parity": "node scripts/qa.mjs",
    "check:assets": "node scripts/check-assets.mjs dist",
    "redirects:check": "node tests/redirect-map-test.mjs && node tests/redirect-retired-routes-test.mjs",
    "redirects:check:vendor": "node tests/redirect-map-test.mjs && node tests/redirect-retired-routes-test.mjs --require-vendor"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "5.18.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "pngjs": "^7.0.0"
  }
}
