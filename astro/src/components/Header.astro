---
import { NAV, SITE, REGISTER_CTA } from '../data/site';

interface Props {
  /** Nav key to mark as the current page (utility pages only — section anchors
   *  are highlighted by aria-current only on the page they belong to). */
  active?: string;
}

const { active = '' } = Astro.props;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
      <img
        class="brand__mark"
        src="/images/SLEFLogo5.png"
        alt=""
        width="170"
        height="115"
        loading="eager"
        decoding="async"
        data-asset-status="approved"
        data-asset-note="organization logo (SLEFLogo5.png, 170x115)"
      />
      <span class="brand__name">
        Somerset Little Eagle<span>Football &amp; Cheer</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {NAV.map((item) => (
          <li>
            <a
              class="nav__link"
              href={item.href}
              aria-current={item.key === active ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--primary btn--sm header-cta header-cta--mobile" href={REGISTER_CTA.href}>
      {REGISTER_CTA.label}
    </a>
    <a class="btn btn--primary btn--sm header-cta" href={REGISTER_CTA.href}>{REGISTER_CTA.label}</a>

    <button
      class="nav__toggle"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <span class="nav__toggle-bar"></span>
      <span class="nav__toggle-bar"></span>
      <span class="nav__toggle-bar"></span>
    </button>
  </div>

  <div class="nav__panel" id="mobile-nav" data-open="false" data-nav-panel>
    <ul aria-label="Primary">
      {NAV.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li><a href="#resources">Parent resources</a></li>
    </ul>
    <a class="btn btn--primary btn--block" href={REGISTER_CTA.href}>{REGISTER_CTA.label} for the 2026 season</a>
  </div>
</header>
