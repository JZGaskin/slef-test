---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { BUILD_FAMILY, BUILD_REV } from '../data/build';
import '../styles/global.css';

interface Props {
  /** Full <title>. */
  title: string;
  /** Meta description. */
  description: string;
  /** Nav key to mark as the current page. */
  active?: string;
  /** Keep the page out of search results (thank-you, 404, styleguide). */
  noindex?: boolean;
  /** Social preview image, absolute path under /images. */
  ogImage?: string;
}

const {
  title,
  description,
  active = '',
  noindex = false,
  ogImage = '/images/redesign/hero-cover.jpg',
} = Astro.props;

// Draft/branch builds are served from a non-production URL and MUST never be
// indexed. Set by netlify.toml for the branch/deploy-preview contexts, and by
// the redesign publisher for a direct draft deploy. Production never sets it.
const DRAFT = (import.meta.env.PUBLIC_NOINDEX ?? process.env.PUBLIC_NOINDEX) === 'true';

// The build emits real .html files (build.format = 'file'), so the canonical URL
// is the clean public form, not the built filename.
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(cleanPath, SITE.url).href;

// Structured data: what this organisation is. Nothing private, nothing invented.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: SITE.name,
  alternateName: SITE.shortName,
  description: `${SITE.descriptor}. Youth football and cheer, grades ${SITE.grades}, season ${SITE.season}.`,
  url: SITE.url,
  logo: `${SITE.url}/images/SLEFLogo5.png`,
  sport: ['American Football', 'Cheerleading'],
  areaServed: { '@type': 'AdministrativeArea', name: 'Somerset County, Pennsylvania' },
  sameAs: [SITE.facebook],
};
---

<!doctype html>
<!-- Build identity marker (data-z33-build*): read by publish-redesign.sh so a deploy
     is identified by its BUILD, not by the photograph in the hero. See src/data/build.ts. -->
<html lang="en" data-z33-build={BUILD_FAMILY} data-z33-build-rev={BUILD_REV}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(DRAFT || noindex) && (
      <meta name="robots" content={DRAFT ? 'noindex, nofollow' : 'noindex, follow'} />
    )}

    <!-- Self-hosted variable fonts: no third-party font CDN, no layout shift. -->
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header active={active} />
    <slot />
    <Footer />

    <!-- Mobile navigation. Inline and tiny on purpose: no framework, no bundle.
         The full navigation is also repeated in the footer, so every destination
         is reachable with JavaScript disabled. -->
    <script is:inline>
      (function () {
        var toggle = document.querySelector('[data-nav-toggle]');
        var panel = document.querySelector('[data-nav-panel]');
        if (!toggle || !panel) return;
        var open = false;

        function setOpen(next) {
          open = next;
          toggle.setAttribute('aria-expanded', String(open));
          panel.setAttribute('data-open', String(open));
          document.body.classList.toggle('nav-open', open);
          if (open) {
            var first = panel.querySelector('a');
            if (first) first.focus();
          }
        }

        toggle.addEventListener('click', function () { setOpen(!open); });

        panel.addEventListener('click', function (event) {
          if (event.target.closest('a')) setOpen(false);
        });

        document.addEventListener('keydown', function (event) {
          if (!open) return;
          if (event.key === 'Escape') { setOpen(false); toggle.focus(); return; }
          if (event.key !== 'Tab') return;
          var items = panel.querySelectorAll('a[href]');
          if (!items.length) return;
          var first = items[0];
          var last = items[items.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        });

        // A resize into the desktop layout must not leave the body scroll-locked.
        window.addEventListener('resize', function () {
          if (window.innerWidth >= 1024 && open) setOpen(false);
        });
      })();
    </script>
  </body>
</html>
