---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  /** Full <title>. */
  title: string;
  /** Meta description (every page had none before). */
  description: string;
  /** Nav key to mark as the current page. */
  active?: string;
  /** Keep the live home-page nav wrapper (see Header.astro). */
  wrapNav?: boolean;
  /** Keep the page out of search results (confirmation pages). */
  noindex?: boolean;
}

const { title, description, active = '', wrapNav = false, noindex = false } = Astro.props;

// Draft/branch builds are served from a non-production URL and MUST never be indexed.
// The flag is set for branch + Deploy Preview contexts in netlify.toml (and by the
// draft-publish script for a direct draft deploy). The production build never sets it,
// so production output is byte-for-byte unchanged by this switch.
const DRAFT = (import.meta.env.PUBLIC_NOINDEX ?? process.env.PUBLIC_NOINDEX) === 'true';

// The build emits real .html files (build.format = 'file') so that the existing
// /pages/about URL keeps working. The canonical URL must therefore be the clean
// public form, not the built filename.
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(cleanPath, SITE.url).href;

// Structured data: tells search engines and social previews what this
// organisation is. Nothing here is private and nothing is invented.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: SITE.name,
  alternateName: SITE.shortName,
  url: SITE.url,
  logo: `${SITE.url}/images/SLEFLogo5.png`,
  sport: ['American Football', 'Cheerleading'],
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Somerset County, Pennsylvania',
  },
  sameAs: [SITE.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(DRAFT || noindex) && (
      <meta name="robots" content={DRAFT ? 'noindex, nofollow' : 'noindex, follow'} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/images/img-1.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Header active={active} wrapNav={wrapNav} />
    <slot />
    <Footer />
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var hamburger = document.querySelector('.hamburger');
        var navLinks = document.querySelector('.nav-links');
        if (hamburger && navLinks) {
          hamburger.addEventListener('click', function () {
            var open = navLinks.classList.toggle('active');
            hamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        }
        var year = document.getElementById('year');
        if (year) year.textContent = new Date().getFullYear();
      });
    </script>
  </body>
</html>
