---
import Base from '../layouts/Base.astro';
import { SITE, REGISTER_CTA } from '../data/site';
---

<Base
  title={`Page not found | ${SITE.name}`}
  description="That page could not be found. Head back to Somerset Little Eagle Football."
  noindex={true}
>
  <main id="main" class="page">
    <div class="wrap notfound">
      <p class="eyebrow">Error 404</p>
      <h1>We couldn’t find that page</h1>
      <p class="lede" style="margin-inline:auto">
        The link may be old, or the page may have moved. Try the homepage, or register for the
        season.
      </p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href="/">Back to the homepage</a>
        <a class="btn btn--outline" href={REGISTER_CTA.href}>Register</a>
      </div>
    </div>
  </main>
</Base>
