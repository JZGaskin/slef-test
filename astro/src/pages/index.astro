---
// HOMEPAGE — the compositional reset.
//
// The approved mock-up is the visual authority for this page, not the previous
// homepage. Composition, band rhythm and the amount of scrolling are all set by
// that reference:
//
//   hero (dominant human sports photograph, copy over a dark scrim)
//   → quick program/value strip
//   → compact mission (white, one photograph)
//   → dark registration band (the strongest section on the page)
//   → compact parent-resource strip
//   → fields (home field prominent, directory folded)
//   → compact community / Facebook block
//   → footer
//
// Protected functionality is unchanged: the same MachForm embeds, the same
// thank-you path, the same redirects, the same anchors (#football, #cheer,
// #about, #register, #resources, #fields) so the navigation and the forced 301s
// from the retired pages keep working.
import Base from '../layouts/Base.astro';
import AppImage from '../components/AppImage.astro';
import {
  SITE,
  VENUES,
  SAFETY_LINKS,
  PLAYER_EXPECTATIONS,
  FACEBOOK_ICON_PATH,
} from '../data/site';

const home = VENUES.find((v) => v.home) ?? VENUES[0];
const away = VENUES.filter((v) => v !== home);
const REGISTER = '/register';
const PROGRAM_ITEMS = [
  {
    id: 'football',
    title: 'Youth Football',
    copy: `Tackle football teams at grade levels ${SITE.grades}, playing in the ${SITE.leagueShort}. Fundamentals, safety and teamwork first.`,
    href: REGISTER,
    link: 'Register for football',
  },
  {
    id: 'cheer',
    title: 'Cheer Program',
    copy: `${SITE.programNote} It runs alongside football in the same ${SITE.season} season.`,
    href: REGISTER,
    link: 'Register for cheer',
  },
  {
    id: 'volunteers',
    title: 'All-Volunteer',
    copy: 'Every coach, officer and team parent is a volunteer. That is the whole organization.',
    href: '/contact',
    link: 'Get involved',
  },
];
---

<Base
  title="Somerset Little Eagle Football | Youth Football & Cheer, Somerset PA"
  description="Somerset Little Eagle Football — developmental youth football and cheer for grades K-6 in Somerset, Pennsylvania. Season runs August through October. Register, find your field, and submit your physical here."
  active="home"
>
  <main id="main">
    <!-- 1. HERO ============================================================
         One large human sports photograph with the copy over it. The dark band is
         full-bleed; the picture inside it is held to a centred frame that is wider
         than the copy shell (so the artwork keeps its right-side presence and the text
         never sits on the crop edge) but always one page-gutter clear of the viewport
         edge. The frame is `--hero-media` wide at most, the copy shell at least, and
         hands itself back to the viewport below the shell width, so phones and tablets
         stay full-bleed.

         The cap is deliberately modest. The photograph is much wider than it is tall
         (1672x941), so `object-fit: cover` scales it to the frame's WIDTH and crops the
         picture vertically — a wider frame means more of the bottom, where the cheer
         block is, is cut away. Keeping the frame at 1300px shows the whole photograph at
         1920x1080 and ~91% of its height at 1440x900, and keeps the player's helmet clear
         of the top edge. At a full-height band the picture is instead cropped
         horizontally, so a desktop rule aligns it to the frame's right edge: the trim
         comes off the dark left, and the player and the cheer block keep their right edge.

         The picture is positioned behind the content, so the text can
         never stretch it (see src/styles/redesign.css §7 and src/data/images.ts). -->
    <section class="hero" id="top">
      <div class="hero__media">
        <AppImage id="footballHero" loading="eager" fetchpriority="high" sizes="(min-width: 1364px) 1300px, (min-width: 1224px) calc(100vw - 4rem), 100vw" position="50% 40%" />
      </div>
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="wrap hero__inner">
        <div class="hero__panel">
          <p class="eyebrow">{SITE.league}</p>
          {/* One semantic h1, read by assistive tech as the whole organization name.
              Its three parts are set as three deliberate lines (see `.hero__title-line`
              in redesign.css) so the words stop running together: Somerset is the place,
              Little Eagle is the brand, Football is the program. The parts are separated
              by real spaces in the text flow, so the accessible name is unchanged. */}
          <h1 class="hero__title"><span class="hero__title-line">Somerset</span>{' '}<span class="hero__title-line hero__title-line--brand">Little Eagle</span>{' '}<span class="hero__title-line">Football</span></h1>
          <p class="hero__lead">
            Developmental youth football and cheer in Somerset, Pennsylvania — a season
            built by the families who show up for it.
          </p>
          <ul class="hero__meta">
            <li>Grades {SITE.grades}</li>
            <li>{SITE.season}</li>
            <li>{SITE.leagueShort}</li>
          </ul>
          <div class="btn-row">
            {/* ONE hero action only: Registration. Football and Cheer sit directly below the
                hero, both are in the navigation, and on mobile a second button costs ~64px
                of vertical space for no extra route. Do not re-add a second CTA without an
                explicit decision. */}
            <a class="btn btn--primary btn--lg" href={REGISTER}>Registration</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. QUICK PROGRAM / VALUE STRIP ==================================== -->
    <section class="strip" id="programs" aria-labelledby="programs-heading">
      <div class="wrap">
        <h2 id="programs-heading" class="sr-only">Programs and community</h2>
        <div class="strip__grid">
          {PROGRAM_ITEMS.map((item) => (
            <article class="strip__item" id={item.id}>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
              <a href={item.href}>{item.link}</a>
              {item.id === 'cheer' && (
                /* The cheer photograph is still missing. The visible placeholder bar was
                   removed at Zach's request (2026-10-19) because it read as unfinished;
                   this declaration stays, hidden, so `npm run check:assets` keeps
                   reporting the gap instead of passing falsely. Do not delete it until a
                   cheer photograph with permission actually exists. */
                <span
                  hidden
                  data-asset-status="temporary-placeholder"
                  data-asset-id="cheerMedia"
                  data-asset-note="No cheer photograph exists with permission to publish. Hidden internal asset-tracking marker: it renders nothing and is not a visitor-facing placeholder."
                />
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. ABOUT / MISSION =============================================== -->
    <section class="section" id="about">
      <div class="wrap about">
        <div class="about__copy">
          <p class="eyebrow">About us</p>
          <h2>Built for Somerset’s young athletes</h2>
          <p>
            Our mission is to provide high level developmental football and cheer programs. We
            participate in the <a href={SITE.leagueUrl} rel="noopener">{SITE.league} ({SITE.leagueShort})</a>
            with tackle football teams at grade levels {SITE.grades}, {SITE.season}, run entirely by
            volunteers.
          </p>
        </div>
        <div class="about__media">
          <AppImage id="fieldNight" sizes="(min-width: 900px) 46vw, 100vw" />
        </div>
      </div>
    </section>

    <!-- 4. REGISTRATION BAND ============================================= -->
    <section class="register" id="register">
      <div class="wrap">
        <div class="wrap-narrow">
          <p class="eyebrow">Registration</p>
          <h2>Register for the season</h2>
          <p class="lede">
            One form for football and cheer — it shows current availability and fees.
          </p>
        </div>
        <div class="register__actions">
          <a class="action action--primary" href={REGISTER}>
            <span class="action__label">Register for Football</span>
            <span class="action__note">Opens the registration form</span>
          </a>
          <a class="action" href={REGISTER}>
            <span class="action__label">Register for Cheer</span>
            <span class="action__note">Same form — choose cheer as the program</span>
          </a>
          <a class="action" href="/physical">
            <span class="action__label">Submit Physical</span>
            <span class="action__note">Required before the first practice</span>
          </a>
        </div>
        <p class="register__note">
          Questions about registration? <a href="/contact">Send us a message</a> and a
          current-season officer will get back to you.
        </p>
      </div>
    </section>

    <!-- 5. PARENT RESOURCES (compact) ===================================== -->
    <section class="section" id="resources">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Parent resources</p>
          <h2>What you’ll need before the season</h2>
        </div>
        <div class="resource-grid">
          <div class="resource">
            <h3>Physical form</h3>
            <p>Required for every football player before the first practice.</p>
            <ul>
              <li><a href={SITE.physicalFormPdf} rel="noopener">Download the form</a></li>
              <li><a href="/physical">Submit a physical</a></li>
            </ul>
          </div>

          <div class="resource">
            <h3>Clearances &amp; safety</h3>
            <p>Every coach must hold these before working with players.</p>
            <ul>
              {SAFETY_LINKS.map((link) => (
                <li><a href={link.href} rel="noopener">{link.label}</a></li>
              ))}
            </ul>
          </div>

          <div class="resource">
            <h3>Player expectations</h3>
            <p>What the season asks of players and families.</p>
            <details>
              <summary>Expectation of all players</summary>
              <ul>
                {PLAYER_EXPECTATIONS.map((item) => <li>{item}</li>)}
              </ul>
              <p>
                {SITE.name}, along with the coaching staff, reserves the right to reduce playing time
                or ask a player not to participate if any of the above expectations are not met.
              </p>
            </details>
          </div>

          <div class="resource">
            <h3>Code of conduct</h3>
            <p>The standard we hold everyone to, on and off the field.</p>
            <details>
              <summary>Read the code of conduct</summary>
              <p>
                The Somerset Little Eagle Football organization strives to provide a safe and fun
                learning environment for our youth football players and cheerleaders. Our
                expectation is that all involved will abide by the code of conduct and recognize
                that this is not an exhaustive list. Violations of this code of conduct or any act
                deemed unbecoming shall be investigated by the executive board and penalties may be
                imposed.
              </p>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. FIELDS (compact) ============================================== -->
    <section class="section section--alt" id="fields">
      <div class="wrap fields">
        <div class="venue-home">
          <p class="eyebrow">Home field</p>
          <h3>{home.name}</h3>
          <address>{home.address}</address>
          <p>Little Eagle teams play here, along with league venues across the region.</p>
          <a class="btn btn--primary btn--sm" href={home.map} target="_blank" rel="noopener">
            Open in maps
          </a>
        </div>

        <div class="fields__more">
          <h3>League venues &amp; directions</h3>
          <p>
            Away games are played at seven league venues across the region. Directions for each are
            one tap away.
          </p>
          <details class="fields__details">
            <summary>View all fields / directions</summary>
            <ul class="venue-list">
              {away.map((venue) => (
                <li>
                  <span>
                    <span class="venue__name">{venue.name}</span>
                    <span class="venue__addr">{venue.address}</span>
                  </span>
                  <a class="venue__map" href={venue.map} target="_blank" rel="noopener">
                    Map<span class="sr-only"> for {venue.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </div>
      </div>
    </section>

    <!-- 7. COMMUNITY ===================================================== -->
    <section class="section" id="community">
      <div class="wrap community">
        <div class="community__media">
          <AppImage id="communityField" sizes="(min-width: 860px) 520px, 100vw" />
        </div>
        <div class="community__copy">
          <p class="eyebrow">Community</p>
          <h2>Follow the season</h2>
          <p>
            News, photos and schedule updates are posted on the organization’s Facebook page
            throughout the season.
          </p>
          <a class="fb-link" href={SITE.facebook} target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" aria-hidden="true"><path d={FACEBOOK_ICON_PATH}></path></svg>
            Somerset Little Eagle Football
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>
