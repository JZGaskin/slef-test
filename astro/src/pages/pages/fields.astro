---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';

// The 8 venues and their addresses are reproduced verbatim from the live page.
// The MAP links are still the original goo.gl short links: they work, and
// rewriting them to coordinates would be a change nobody has reviewed yet.
const locations = [
  { name: 'Somerset', address: '645 S Columbia Ave., Somerset, PA 15501', map: 'https://goo.gl/maps/MuCZWz6ZBRE5FK2w6' },
  { name: 'Bishop McCort', address: '100 Johns Street, Johnstown, PA 15901 - Point Stadium', map: 'https://goo.gl/maps/GGonazVRiFBz5hWP6' },
  { name: 'Central Cambria', address: '999 9th St Colver, PA 15927', map: 'https://goo.gl/maps/FTXMRQJDoDGdu2Eq5' },
  { name: 'Forest Hills', address: 'Playground Drive Johnstown PA 15904', map: 'https://goo.gl/maps/HTpY1pxUhKe4mmvs8' },
  { name: 'Johnstown', address: '222 Central Ave. Johnstown, PA 15902', map: 'https://goo.gl/maps/RB6Z3a5qgbxfCB3w9' },
  { name: 'Mainline - Penn Cambria', address: 'Memorial Drive Lilly, PA 15938', map: 'https://goo.gl/maps/PovV8dp5zthRDYa3A' },
  { name: 'Richland', address: '1 Academic Ave. Johnstown, PA 15904', map: 'https://goo.gl/maps/LkGJ7uYrnB2NQHwk8' },
  { name: 'Westmont', address: '827 Diamond Blvd. Johnstown, PA 15905', map: 'https://goo.gl/maps/Kj6ohoie3VbtErje9' },
];
---

<Base
  title="Field Locations | Little Eagle Football & Cheer"
  description="Field locations and directions for Somerset Little Eagle Football & Cheer — Somerset, Bishop McCort, Central Cambria, Forest Hills, Johnstown, Mainline (Penn Cambria), Richland and Westmont."
  active="fields"
>
  <main class="main-content">
    <section class="heroturf">
      <div class="heroturf-content">
        <h1>
          <span>Field Locations</span>
        </h1>
        <h2>
          <span>Little Eagle Football &amp; Cheer</span>
        </h2>
        <a class="cta-button" href="/pages/register">Register Today!</a>
      </div>
    </section>
    <section class="field-locations">
      <h2>Field Locations</h2>
      {
        locations.map((loc) => (
          <div class="location">
            <h3>{loc.name}</h3>
            <p>{loc.address}</p>
            <a href={loc.map} target="_blank" rel="noopener">
              MAP
            </a>
          </div>
        ))
      }
    </section>
  </main>
</Base>
