---
import Base from '../layouts/Base.astro';
import MachFormEmbed from '../components/MachFormEmbed.astro';
import { MACHFORM, SITE } from '../data/site';

const form = MACHFORM.forms.registration2026;
---

<Base
  title={`Register | ${SITE.name}`}
  description="Register for the 2026 season with Somerset Little Eagle Football. Football and cheer, grade levels K-6, Somerset PA. Registration is handled through our secure registration form."
  active="register"
>
  <main id="main" class="page">
    <div class="page__head">
      <div class="wrap">
        <p class="eyebrow">Registration</p>
        <h1>Register for the 2026 season</h1>
        <p>
          You will need your player’s information and a payment method. The form shows current
          availability and fees. All football players must have a completed physical before the
          first practice — you can <a href="/physical">submit it here</a>.
        </p>
      </div>
    </div>
    <div class="page__body">
      <div class="wrap wrap--narrow">
        <div class="form-card">
          <MachFormEmbed id={form.id} title={form.title} height={form.height} />
        </div>
      </div>
    </div>
  </main>
</Base>
